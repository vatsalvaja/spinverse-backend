# =============================================================================
# SPINVERSE backend - environment variables
# Copy this file to `.env` and replace the placeholder values.
#   cp .env.example .env        (Windows PowerShell: Copy-Item .env.example .env)
# `.env` is git-ignored and must NEVER be committed.
# =============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Global route prefix. Final URLs look like http://localhost:4000/api/v1/health
API_PREFIX=api/v1
# Comma-separated list of allowed browser origins (your frontend URL(s)).
CORS_ORIGINS=http://localhost:3000

# --- Swagger / OpenAPI -------------------------------------------------------
# Set to false to disable the interactive docs (recommended in production).
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Database (PostgreSQL) ---------------------------------------------------
# >>> ENTER YOUR DATABASE CREDENTIALS HERE <<<
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# URL-encode special characters in the password (e.g. "@" -> "%40").
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?schema=public"

# --- Authentication (JWT + bcrypt) -------------------------------------------
# >>> GENERATE YOUR OWN SECRETS - the app refuses to start with placeholders <<<
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Use two DIFFERENT values, each at least 32 characters. Never commit them.
JWT_ACCESS_SECRET=CHANGE_ME_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret
# Lifetimes: a number followed by s, m, h or d (e.g. 900s, 15m, 12h, 7d).
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# bcrypt cost factor (10-15). Higher is slower and more secure.
BCRYPT_SALT_ROUNDS=12

# --- Game packages (Phase 5) -------------------------------------------------
# Folder where uploaded game ZIPs and their unpacked files are stored (created
# automatically). Keep it outside any publicly served folder. Relative paths are
# resolved from the folder you start the backend in.
PACKAGE_STORAGE_DIR=./storage/game-packages
# How long a game launch link stays valid (s, m, h or d).
GAME_LAUNCH_EXPIRES_IN=4h
