{
  "name": "spinverse-backend",
  "version": "0.1.0",
  "description": "SPINVERSE backend API (Phase 1 foundation)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.cjs",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "prisma:create-super-admin": "node prisma/create-super-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.1",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.1",
    "@nestjs/swagger": "^12.1.2",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "prisma": "^6.19.3",
    "typescript": "^6.0.3"
  }
}
